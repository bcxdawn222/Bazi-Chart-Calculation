@import "./styles/motion.wxss";

/************************************************************************************
 * FileName : app.wxss
 * Description : 参考包的深红黑底、珊瑚细线与宋体标题。
 ************************************************************************************/

page {
  --color-bg: #100807;
  --color-bg-warm: #160b09;
  --color-surface: #1e100d;
  --color-surface-raised: #251410;
  --color-surface-muted: #1a0d0b;
  --color-primary: #d96b4f;
  --color-primary-dark: #b84a30;
  --color-primary-soft: #31160f;
  --color-accent: #f0a886;
  --color-accent-soft: #27130f;
  --color-text: #f5ede6;
  --color-text-secondary: #d8bfb1;
  --color-text-muted: #b39c92;
  --color-text-hint: #88746d;
  --color-border: rgba(240,168,134,.26);
  --color-border-light: rgba(245,237,230,.08);
  --color-success: #aebfc0;
  --color-success-soft: #1e2626;
  --radius-sm: 8rpx;
  --radius-md: 10rpx;
  --radius-lg: 12rpx;
  --radius-pill: 10rpx;
  --shadow-sm: inset 0 1rpx 0 rgba(245,237,230,.05);
  --shadow-md: 0 8rpx 24rpx rgba(0,0,0,.2);
  --shadow-lg: 0 14rpx 40rpx rgba(217,107,79,.3);
  --space-xs: 8rpx;
  --space-sm: 12rpx;
  --space-md: 16rpx;
  --space-lg: 24rpx;
  --space-xl: 32rpx;
  --touch-min: 88rpx;
  --font-body: 30rpx;
  --font-caption: 28rpx;
  --font-label: 30rpx;
  --font-title: 36rpx;
  --font-display: 40rpx;
  --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
  --duration-fast: 120ms;
  --duration-normal: 180ms;
  background: var(--color-bg);
  color: var(--color-text);
  font-family: "Noto Sans SC", "PingFang SC", "HarmonyOS Sans SC", "Source Han Sans SC", "Microsoft YaHei", sans-serif;
  font-size: var(--font-body);
  letter-spacing: 0;
  line-height: 1.6;
  min-height: 100%;
}

.serif {
  font-family: "Noto Serif SC", "Source Han Serif SC", "Songti SC", "STSong", "SimSun", serif;
}

button {
  border-radius: var(--radius-md) !important;
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

button::after {
  border: 0;
}

.page-shell {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 24rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  max-width: 960rpx;
  margin: 0 auto;
}

.panel {
  background: transparent;
  border: 0;
  border-radius: 0;
  box-shadow: none;
  box-sizing: border-box;
  margin-bottom: 40rpx;
  overflow: hidden;
  padding: 0;
  position: relative;
}

.section-head {
  align-items: center;
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 8rpx 16rpx;
  padding: 24rpx 0;
}

.section-head-titles {
  align-items: center;
  display: flex;
}

.section-accent {
  display: none;
}

.section-title {
  color: var(--color-accent);
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.4;
}

.section-caption {
  color: var(--color-text-muted);
  font-size: var(--font-caption);
}

.panel-sub {
  background: transparent;
  border-radius: 0;
  padding: 4rpx 0;
}

.muted {
  color: var(--color-text-muted);
}

.gold-btn {
  background: linear-gradient(135deg, #f0a886 0%, #d96b4f 45%, #b84a30 100%);
  border: 0;
  border-radius: var(--radius-md) !important;
  color: #2b0f08;
  font-size: 30rpx;
  font-weight: 500;
  font-family: "Noto Serif SC", "Songti SC", "SimSun", serif;
  height: 100rpx;
  letter-spacing: 0;
  line-height: 100rpx;
  margin: 28rpx 0 16rpx;
  min-height: var(--touch-min);
  padding: 0;
  text-align: center;
  width: 100%;
  position: relative;
  overflow: hidden;
  box-shadow: 0 14rpx 40rpx rgba(217,107,79,.35), inset 0 1rpx 0 rgba(255,239,228,.45);
}

.gold-btn[disabled] {
  background: #38221a;
  color: #b39c92;
  box-shadow: none;
  opacity: 1;
}

.press-gold {
  background: var(--color-primary-dark) !important;
  transform: scale(.97);
}

.press-card,
.press-panel,
.press-row,
.press-seg,
.press-tab,
.press-dim,
.press-ghost {
  opacity: .7;
}

.press-palace {
  background: var(--color-primary-soft) !important;
  border-color: var(--color-primary) !important;
}

.chevron {
  border-bottom: 2rpx solid var(--color-text-muted);
  border-right: 2rpx solid var(--color-text-muted);
  box-sizing: border-box;
  display: inline-block;
  height: 12rpx;
  margin-left: 8rpx;
  width: 12rpx;
}

.chevron-right {
  transform: rotate(-45deg) translateY(-2rpx);
}

.chevron-down {
  transform: rotate(45deg) translateY(-2rpx);
}

.chevron-up {
  transform: rotate(-135deg) translateY(2rpx);
}

.status-dot {
  display: none;
}

.status-dot-live {
  display: none;
}

.field-label {
  color: var(--color-text-secondary);
  display: block;
  font-size: var(--font-caption);
  margin-bottom: 8rpx;
}

.text-input,
.picker-value {
  background: var(--color-bg-warm);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  box-sizing: border-box;
  color: var(--color-text);
  font-size: 32rpx;
  height: var(--touch-min);
  line-height: calc(var(--touch-min) - 2rpx);
  min-height: var(--touch-min);
  padding: 0 16rpx;
}

.input-placeholder {
  color: var(--color-text-hint);
}

.field-help-error,
.field-help.field-help-error {
  color: var(--color-primary);
  display: block;
  font-size: var(--font-caption);
  line-height: 1.5;
  margin: 8rpx 0 0;
}

.segmented {
  background: var(--color-surface-muted);
  border-radius: var(--radius-sm);
  display: grid;
  gap: 4rpx;
  padding: 4rpx;
}

.segment {
  border-radius: 6rpx;
  color: var(--color-text-muted);
  font-size: var(--font-label);
  height: 88rpx;
  line-height: 88rpx;
  min-height: 88rpx;
  text-align: center;
}

.segment-active {
  background: linear-gradient(135deg, #f0a886, #b84a30);
  color: #2b0f08;
  font-weight: 600;
}
