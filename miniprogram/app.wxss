@import "./styles/motion.wxss";

/************************************************************************************
 * FileName : app.wxss
 * Description : 参考包的深红黑底、珊瑚细线与宋体标题。
 ************************************************************************************/

page {
  /* 基础配色 · 参考站色板，不改动 */
  --color-bg: #100807;
  --color-bg-warm: #160b09;
  --color-surface: #1e100d;
  --color-surface-raised: #251410;
  --color-surface-muted: #1a0d0b;
  /* 仅用于渐变纵深的更深一档底色，不替代 --color-bg */
  --color-bg-deep: #0a0504;

  /* 主色调 · 参考站色板 */
  --color-primary: #d96b4f;
  --color-primary-dark: #b84a30;
  --color-primary-soft: #31160f;
  --color-accent: #f0a886;
  --color-accent-soft: #27130f;
  /* 高光档，用于描边与文字提亮 */
  --color-accent-bright: #f5c297;

  /* 吉凶语义色 */
  --color-lucky: #d4af37;
  --color-lucky-soft: rgba(212,175,55,.12);
  --color-neutral: #8b7355;
  --color-unlucky: #c9302c;
  --color-unlucky-soft: rgba(201,48,44,.12);

  /* 五行色系 */
  --wood: #4a7c59;
  --fire: #c9573d;
  --earth: #c19a6b;
  --metal: #d4af37;
  --water: #3d5a6f;

  /* 文字层级 · 正文沿用参考站 #f5ede6 */
  --color-text: #f5ede6;
  --color-text-bright: #fff5ed;
  --color-text-secondary: #e8d4c4;
  --color-text-muted: #c4b0a4;
  --color-text-hint: #9a8680;

  /* 边框与分隔 */
  --color-border: rgba(240,168,134,.26);
  --color-border-light: rgba(245,237,230,.07);
  --color-divider: rgba(240,168,134,.12);

  /* 成功/提示 */
  --color-success: #aebfc0;
  --color-success-soft: #1e2626;
  --color-warning: #e8a95f;
  --color-warning-soft: rgba(232,169,95,.12);

  /* 圆角系统 */
  --radius-sm: 10rpx;
  --radius-md: 14rpx;
  --radius-lg: 18rpx;
  --radius-xl: 24rpx;
  --radius-pill: 200rpx;

  /* 阴影系统 - 更精致 */
  --shadow-card: 0 4rpx 24rpx rgba(0,0,0,.4), 0 0 1rpx rgba(245,194,151,.3);
  --shadow-card-hover: 0 12rpx 48rpx rgba(0,0,0,.5), 0 0 2rpx rgba(245,194,151,.5);
  --shadow-glow: 0 0 32rpx rgba(232,123,95,.4);
  --shadow-glow-strong: 0 0 56rpx rgba(232,123,95,.6);
  --shadow-inner: inset 0 2rpx 8rpx rgba(0,0,0,.3);

  /* 间距系统 */
  --space-xs: 8rpx;
  --space-sm: 12rpx;
  --space-md: 16rpx;
  --space-lg: 24rpx;
  --space-xl: 32rpx;
  --space-xxl: 48rpx;
  --touch-min: 88rpx;

  /* 字体系统 */
  --font-body: 30rpx;
  --font-caption: 26rpx;
  --font-label: 28rpx;
  --font-title: 36rpx;
  --font-display: 42rpx;
  --font-hero: 52rpx;

  /* 动画缓动 */
  --ease-out: cubic-bezier(0.19, 1, 0.22, 1);
  --ease-in-out: cubic-bezier(0.65, 0, 0.35, 1);
  --ease-elastic: cubic-bezier(0.68, -0.55, 0.265, 1.55);
  --duration-fast: 200ms;
  --duration-normal: 320ms;
  --duration-slow: 480ms;

  /* 毛玻璃效果 */
  --glass-bg: rgba(30,16,13,.75);
  --glass-border: rgba(245,194,151,.15);

  background: var(--color-bg);
  color: var(--color-text);
  font-family: "Noto Sans SC", "PingFang SC", "HarmonyOS Sans SC", "Source Han Sans SC", "Microsoft YaHei", sans-serif;
  font-size: var(--font-body);
  letter-spacing: 0.02em;
  line-height: 1.6;
  min-height: 100%;
}

.serif {
  font-family: "Noto Serif SC", "Source Han Serif SC", "Songti SC", "STSong", "SimSun", serif;
}

button {
  border-radius: var(--radius-md) !important;
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

button::after {
  border: 0;
}

.page-shell {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 24rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  max-width: 960rpx;
  margin: 0 auto;
}

.panel {
  background: var(--glass-bg);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  border: 1rpx solid var(--glass-border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  box-sizing: border-box;
  margin-bottom: 40rpx;
  overflow: hidden;
  padding: var(--space-lg);
  position: relative;
  transition: all var(--duration-normal) var(--ease-out);
}

.panel::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(245,194,151,.3), transparent);
  opacity: 0.6;
}

.section-head {
  align-items: center;
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 8rpx 16rpx;
  padding: 24rpx 0;
}

.section-head-titles {
  align-items: center;
  display: flex;
}

.section-accent {
  display: none;
}

.section-title {
  color: var(--color-accent);
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.4;
}

.section-caption {
  color: var(--color-text-muted);
  font-size: var(--font-caption);
}

.panel-sub {
  background: transparent;
  border-radius: 0;
  padding: 4rpx 0;
}

.muted {
  color: var(--color-text-muted);
}

.gold-btn {
  background: linear-gradient(135deg, #f0a886 0%, #d96b4f 45%, #b84a30 100%) !important;
  border: 0;
  border-radius: 24rpx !important;
  color: #2b0f08 !important;
  font-size: 30rpx;
  font-weight: 600;
  font-family: "Noto Serif SC", "Source Han Serif SC", "Songti SC", "STSong", "SimSun", serif;
  height: 100rpx;
  letter-spacing: 10rpx;
  line-height: 100rpx;
  margin: 28rpx 0 16rpx;
  min-height: var(--touch-min);
  padding: 0;
  text-align: center;
  width: 100%;
  position: relative;
  overflow: hidden;
  box-shadow: 0 14rpx 40rpx rgba(217,107,79,.45), inset 0 1rpx 0 rgba(255,239,228,.45);
}

.gold-btn[disabled] {
  background: #2a1612 !important;
  color: #8a736b !important;
  box-shadow: none;
  letter-spacing: 10rpx;
  opacity: 1;
}

.press-gold {
  background: var(--color-primary-dark) !important;
  transform: scale(.97);
}

.press-card,
.press-panel,
.press-row,
.press-seg,
.press-tab,
.press-dim,
.press-ghost {
  opacity: .7;
}

.press-palace {
  background: var(--color-primary-soft) !important;
  border-color: var(--color-primary) !important;
}

.chevron {
  border-bottom: 2rpx solid var(--color-text-muted);
  border-right: 2rpx solid var(--color-text-muted);
  box-sizing: border-box;
  display: inline-block;
  height: 12rpx;
  margin-left: 8rpx;
  width: 12rpx;
}

.chevron-right {
  transform: rotate(-45deg) translateY(-2rpx);
}

.chevron-down {
  transform: rotate(45deg) translateY(-2rpx);
}

.chevron-up {
  transform: rotate(-135deg) translateY(2rpx);
}

.status-dot {
  display: none;
}

.status-dot-live {
  display: none;
}

.field-label {
  color: var(--color-text-secondary);
  display: block;
  font-size: var(--font-caption);
  margin-bottom: 8rpx;
}

.text-input,
.picker-value {
  background: var(--color-bg-warm);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  box-sizing: border-box;
  color: var(--color-text);
  font-size: 32rpx;
  height: var(--touch-min);
  line-height: calc(var(--touch-min) - 2rpx);
  min-height: var(--touch-min);
  padding: 0 16rpx;
}

.input-placeholder {
  color: var(--color-text-hint);
}

.field-help-error,
.field-help.field-help-error {
  color: var(--color-primary);
  display: block;
  font-size: var(--font-caption);
  line-height: 1.5;
  margin: 8rpx 0 0;
}

.segmented {
  background: var(--color-surface-muted);
  border-radius: var(--radius-sm);
  display: grid;
  gap: 4rpx;
  padding: 4rpx;
}

.segment {
  border-radius: 6rpx;
  color: var(--color-text-muted);
  font-size: var(--font-label);
  height: 88rpx;
  line-height: 88rpx;
  min-height: 88rpx;
  text-align: center;
}

.segment-active {
  background: linear-gradient(135deg, #f0a886, #b84a30);
  color: #2b0f08;
  font-weight: 600;
}
