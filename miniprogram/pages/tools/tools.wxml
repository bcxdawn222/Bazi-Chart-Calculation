<view class="page-shell tool-page">
  <view class="tool-hero">
    <view class="tool-hero-copy">
      <view class="tool-kicker">
        <view class="kicker-line"></view>
        <text class="tool-title serif">{{meta.title}}</text>
        <view class="kicker-line"></view>
      </view>
      <text class="tool-subtitle">{{meta.subtitle}}</text>
    </view>
  </view>

  <view class="panel tool-form" wx:if="{{mode == 'daily' || mode == 'wealth'}}">
    <view class="section-head">
      <view class="section-head-titles"><view class="section-accent"></view><text class="section-title serif">命盘运势</text></view>
      <text class="section-caption">最近命盘</text>
    </view>
    <view class="chart-state" wx:if="{{hasChart}}"><text class="status-dot"></text>已读取最近命盘</view>
    <view class="empty-state" wx:else>
      <text>尚未找到命盘，请先完成八字排盘。</text>
      <button class="minor-button" bindtap="goToChart">去排盘</button>
    </view>
    <view class="field-block" wx:if="{{mode == 'daily'}}">
      <text class="field-label">查看日期</text>
      <picker mode="date" value="{{date}}" start="1901-01-06" end="2049-12-31" bindchange="onDateChange">
        <view class="picker-value"><text>{{date}}</text><view class="chevron chevron-right"></view></view>
      </picker>
      <text class="field-help field-help-error" wx:if="{{fieldErrors.date}}">{{fieldErrors.date}}</text>
    </view>
    <view class="field-block" wx:if="{{mode == 'wealth'}}">
      <text class="field-label">查看年度</text>
      <input class="text-input" type="number" value="{{year}}" data-field="year" bindinput="onFieldInput" />
      <text class="field-help field-help-error" wx:if="{{fieldErrors.year}}">{{fieldErrors.year}}</text>
    </view>
    <button class="gold-btn" bindtap="runTool" disabled="{{!hasChart}}" hover-class="press-gold">生成运势内容<view class="button-sheen" aria-hidden="true"></view></button>
  </view>

  <view class="panel tool-form" wx:if="{{mode == 'question' || mode == 'liuyao'}}">
    <view class="section-head">
      <view class="section-head-titles"><view class="section-accent"></view><text class="section-title serif">起卦资料</text></view>
      <text class="section-caption">时间起卦</text>
    </view>
    <view class="field-block field-stack">
      <text class="field-label">所问事项{{mode == 'liuyao' ? '（可选）' : ''}}</text>
      <textarea class="text-area" maxlength="80" value="{{question}}" data-field="question" bindinput="onFieldInput" placeholder="请简要写下所问事项" placeholder-class="input-placeholder"></textarea>
      <text class="field-help field-help-error" wx:if="{{fieldErrors.question}}">{{fieldErrors.question}}</text>
    </view>
    <view class="field-grid">
      <view class="field-block">
        <text class="field-label">起卦日期</text>
        <picker mode="date" value="{{date}}" start="1901-01-06" end="2049-12-31" bindchange="onDateChange"><view class="picker-value">{{date}}<view class="chevron chevron-right"></view></view></picker>
        <text class="field-help field-help-error" wx:if="{{fieldErrors.date}}">{{fieldErrors.date}}</text>
      </view>
      <view class="field-block">
        <text class="field-label">起卦时间</text>
        <picker mode="time" value="{{time}}" bindchange="onTimeChange"><view class="picker-value">{{time}}<view class="chevron chevron-right"></view></view></picker>
        <text class="field-help field-help-error" wx:if="{{fieldErrors.time}}">{{fieldErrors.time}}</text>
      </view>
    </view>
    <button class="gold-btn" bindtap="runTool" hover-class="press-gold">开始起卦<view class="button-sheen" aria-hidden="true"></view></button>
  </view>

  <view class="panel tool-form" wx:if="{{mode == 'compatibility'}}">
    <view class="section-head">
      <view class="section-head-titles"><view class="section-accent"></view><text class="section-title serif">双方资料</text></view>
      <text class="section-caption">阳历输入</text>
    </view>
    <view class="party-block">
      <text class="party-title serif">男方</text>
      <view class="field-block">
        <text class="field-label">姓名</text>
        <input class="text-input" value="{{leftName}}" data-field="leftName" bindinput="onFieldInput" placeholder="例如：张三" placeholder-class="input-placeholder" />
        <text class="field-help field-help-error" wx:if="{{fieldErrors.leftName}}">{{fieldErrors.leftName}}</text>
      </view>
      <view class="field-block">
        <text class="field-label">出生地点</text>
        <input class="text-input" value="{{leftLocationLabel}}" data-field="leftLocationLabel" bindinput="onFieldInput" placeholder="例如：北京" placeholder-class="input-placeholder" />
        <text class="field-help field-help-error" wx:if="{{fieldErrors.leftLocationLabel}}">{{fieldErrors.leftLocationLabel}}</text>
      </view>
      <view class="field-grid compact-grid">
        <view class="field-block">
          <text class="field-label">出生日期</text>
          <picker mode="date" value="{{leftDate}}" start="1901-01-06" end="2049-12-31" bindchange="onLeftDateChange"><view class="picker-value">{{leftDate}}<view class="chevron chevron-right"></view></view></picker>
          <text class="field-help field-help-error" wx:if="{{fieldErrors.leftDate}}">{{fieldErrors.leftDate}}</text>
        </view>
        <view class="field-block">
          <text class="field-label">出生时间</text>
          <picker mode="time" value="{{leftTime}}" bindchange="onLeftTimeChange"><view class="picker-value">{{leftTime}}<view class="chevron chevron-right"></view></view></picker>
          <text class="field-help field-help-error" wx:if="{{fieldErrors.leftTime}}">{{fieldErrors.leftTime}}</text>
        </view>
      </view>
      <view class="field-block">
        <text class="field-label">经度</text>
        <input class="text-input" type="digit" value="{{leftLocation}}" data-field="leftLocation" bindinput="onFieldInput" placeholder="例如：116.40" placeholder-class="input-placeholder" />
        <text class="field-help field-help-error" wx:if="{{fieldErrors.leftLocation}}">{{fieldErrors.leftLocation}}</text>
      </view>
      <view class="option-row"><text>真太阳时</text><switch checked="{{leftRealSolarTime}}" data-field="leftRealSolarTime" bindchange="onCompatibilitySolarChange" color="#d96b4f" /></view>
      <view class="field-block">
        <text class="field-label">子时口径</text>
        <picker mode="selector" range="{{ziHourLabels}}" value="{{leftZiHourMode == 'late' ? 1 : 0}}" data-field="leftZiHourMode" bindchange="onCompatibilityZiChange"><view class="picker-value">{{leftZiHourMode == 'late' ? '晚子时' : '早子时'}}<view class="chevron chevron-right"></view></view></picker>
      </view>
    </view>
    <view class="party-block">
      <text class="party-title serif">女方</text>
      <view class="field-block">
        <text class="field-label">姓名</text>
        <input class="text-input" value="{{rightName}}" data-field="rightName" bindinput="onFieldInput" placeholder="例如：李四" placeholder-class="input-placeholder" />
        <text class="field-help field-help-error" wx:if="{{fieldErrors.rightName}}">{{fieldErrors.rightName}}</text>
      </view>
      <view class="field-block">
        <text class="field-label">出生地点</text>
        <input class="text-input" value="{{rightLocationLabel}}" data-field="rightLocationLabel" bindinput="onFieldInput" placeholder="例如：上海" placeholder-class="input-placeholder" />
        <text class="field-help field-help-error" wx:if="{{fieldErrors.rightLocationLabel}}">{{fieldErrors.rightLocationLabel}}</text>
      </view>
      <view class="field-grid compact-grid">
        <view class="field-block">
          <text class="field-label">出生日期</text>
          <picker mode="date" value="{{rightDate}}" start="1901-01-06" end="2049-12-31" bindchange="onRightDateChange"><view class="picker-value">{{rightDate}}<view class="chevron chevron-right"></view></view></picker>
          <text class="field-help field-help-error" wx:if="{{fieldErrors.rightDate}}">{{fieldErrors.rightDate}}</text>
        </view>
        <view class="field-block">
          <text class="field-label">出生时间</text>
          <picker mode="time" value="{{rightTime}}" bindchange="onRightTimeChange"><view class="picker-value">{{rightTime}}<view class="chevron chevron-right"></view></view></picker>
          <text class="field-help field-help-error" wx:if="{{fieldErrors.rightTime}}">{{fieldErrors.rightTime}}</text>
        </view>
      </view>
      <view class="field-block">
        <text class="field-label">经度</text>
        <input class="text-input" type="digit" value="{{rightLocation}}" data-field="rightLocation" bindinput="onFieldInput" placeholder="例如：120.00" placeholder-class="input-placeholder" />
        <text class="field-help field-help-error" wx:if="{{fieldErrors.rightLocation}}">{{fieldErrors.rightLocation}}</text>
      </view>
      <view class="option-row"><text>真太阳时</text><switch checked="{{rightRealSolarTime}}" data-field="rightRealSolarTime" bindchange="onCompatibilitySolarChange" color="#d96b4f" /></view>
      <view class="field-block">
        <text class="field-label">子时口径</text>
        <picker mode="selector" range="{{ziHourLabels}}" value="{{rightZiHourMode == 'late' ? 1 : 0}}" data-field="rightZiHourMode" bindchange="onCompatibilityZiChange"><view class="picker-value">{{rightZiHourMode == 'late' ? '晚子时' : '早子时'}}<view class="chevron chevron-right"></view></view></picker>
      </view>
    </view>
    <button class="gold-btn" bindtap="runTool" hover-class="press-gold">生成合婚参考<view class="button-sheen" aria-hidden="true"></view></button>
  </view>

  <view class="panel tool-form" wx:if="{{mode == 'naming'}}">
    <view class="section-head">
      <view class="section-head-titles"><view class="section-accent"></view><text class="section-title serif">名号资料</text></view>
      <text class="section-caption">康熙笔画</text>
    </view>
    <view class="field-grid">
      <view class="field-block"><text class="field-label">姓氏</text><input class="text-input" value="{{surname}}" data-field="surname" bindinput="onFieldInput" maxlength="2" placeholder="例如：李" placeholder-class="input-placeholder" /></view>
      <view class="field-block"><text class="field-label">名字</text><input class="text-input" value="{{givenName}}" data-field="givenName" bindinput="onFieldInput" maxlength="2" placeholder="例如：明" placeholder-class="input-placeholder" /></view>
    </view>
    <view class="form-tip {{namingReady ? 'form-tip-ready' : ''}}">{{namingHint}}</view>
    <view class="option-row" wx:if="{{hasChart}}"><text>关联最近命盘</text><switch checked="{{useNamingChart}}" bindchange="onNamingChartChange" color="#d96b4f" /></view>
    <button class="gold-btn" bindtap="runTool" disabled="{{!namingReady}}" hover-class="press-gold">计算五格<view class="button-sheen" aria-hidden="true"></view></button>
  </view>

  <view id="tool-result" class="result-stack" wx:if="{{result}}">
    <view class="panel result-card" wx:if="{{mode == 'daily'}}">
      <text class="result-title serif">{{result.title}}</text>
      <view class="result-tags"><text>{{result.pillar}}</text><text>{{result.relation}}</text></view>
      <text class="result-summary">{{result.summary}}</text>
      <view class="detail-row" wx:for="{{result.sections}}" wx:key="label"><text class="detail-label">{{item.label}}</text><text class="detail-text">{{item.text}}</text></view>
      <text class="evidence-note">{{result.evidence}}</text>
    </view>

    <view class="panel result-card" wx:if="{{mode == 'wealth'}}">
      <text class="result-title serif">{{result.title}}</text>
      <view class="result-tags"><text>{{result.pillar}}</text><text>{{result.relation}}</text></view>
      <text class="result-summary">{{result.summary}}</text>
      <text class="wealth-note">{{result.wealthNote}}</text>
      <view class="month-grid"><view class="month-item" wx:for="{{result.months}}" wx:key="month"><text>{{item.month}}月</text><text>{{item.focus}}</text></view></view>
      <text class="evidence-note">{{result.evidence}}</text>
    </view>

    <view class="panel result-card" wx:if="{{mode == 'question' || mode == 'liuyao'}}">
      <text class="result-title serif">{{result.title}}</text>
      <view class="result-tags"><text>上卦 {{result.upper.name}}·{{result.upper.nature}}</text><text>下卦 {{result.lower.name}}·{{result.lower.nature}}</text><text>动爻 {{result.movingLine}}</text></view>
      <view class="hexagram"><view class="hex-line {{item.moving ? 'moving-line' : ''}}" wx:for="{{result.lines}}" wx:key="position"><text>{{item.symbol}}</text><text>{{item.position}}爻{{item.moving ? ' · 动' : ''}}</text></view></view>
      <text class="result-summary">所问：{{result.question}}</text>
      <text class="formula-note">{{result.formula}}</text>
      <text class="evidence-note">{{result.note}}</text>
    </view>

    <view class="panel result-card" wx:if="{{mode == 'compatibility'}}">
      <text class="result-title serif">双方命盘关系</text>
      <view class="couple-grid">
        <view class="person-card"><text>{{result.left.name}}</text><view class="pillar-mini"><text wx:for="{{result.left.pillarList}}" wx:key="label">{{item.label}} {{item.value}}</text></view><text>{{result.left.summary}}</text></view>
        <view class="person-card"><text>{{result.right.name}}</text><view class="pillar-mini"><text wx:for="{{result.right.pillarList}}" wx:key="label">{{item.label}} {{item.value}}</text></view><text>{{result.right.summary}}</text></view>
      </view>
      <view class="result-tags"><text>{{result.branchRelation}}</text></view>
      <text class="result-summary">{{result.stemRelation}}</text>
      <text class="result-summary">{{result.summary}}</text>
      <view class="detail-row" wx:for="{{result.referenceSections}}" wx:key="label"><text class="detail-label">{{item.label}}</text><view><text class="detail-text">{{item.value}}</text><text class="detail-subtext">{{item.detail}}</text></view></view>
      <view class="time-basis"><text>{{result.left.name}}：{{result.left.timeBasis.locationLabel}} · {{result.left.timeBasis.correctedTime}} · {{result.left.timeBasis.ziHourMode == 'late' ? '晚子时' : '早子时'}}</text><text>{{result.right.name}}：{{result.right.timeBasis.locationLabel}} · {{result.right.timeBasis.correctedTime}} · {{result.right.timeBasis.ziHourMode == 'late' ? '晚子时' : '早子时'}}</text></view>
      <view class="element-pair" wx:for="{{result.elements}}" wx:key="label"><text>{{item.label}}</text><text>{{result.left.name}} {{item.left}}</text><text>{{result.right.name}} {{item.right}}</text><text>合计 {{item.total}}</text></view>
      <text class="evidence-note">{{result.note}}</text>
    </view>

    <view class="panel result-card" wx:if="{{mode == 'naming'}}">
      <text class="result-title serif">{{result.fullName}}</text>
      <view class="character-row"><view wx:for="{{result.characters}}" wx:key="character"><text class="character serif">{{item.character}}</text><text>{{item.stroke}} 画</text></view></view>
      <view class="grid-list"><view class="grid-item" wx:for="{{result.grids}}" wx:key="name"><text>{{item.name}}</text><text class="grid-number serif">{{item.number}}</text><text>{{item.element}}</text></view></view>
      <text class="result-summary">三才：{{result.threeTalents}}</text>
      <view class="chart-reference" wx:if="{{result.chartReference}}"><text>关联命盘：日主 {{result.chartReference.dayMaster}} · 日柱 {{result.chartReference.dayPillar}}</text><text>{{result.chartReference.elementSummary}}</text><text>{{result.chartReference.note}}</text></view>
      <text class="evidence-note">{{result.note}}</text>
    </view>
  </view>

  <view class="culture-note">传统文化研究与娱乐参考，请结合现实情况独立判断。</view>
</view>
