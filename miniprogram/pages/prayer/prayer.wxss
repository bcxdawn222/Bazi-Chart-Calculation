.prayer-page {
  background: var(--color-bg);
  padding-top: 12rpx;
  animation: xj-rise .55s cubic-bezier(.22,.9,.24,1) both;
}

.prayer-hero {
  align-items: center;
  display: flex;
  padding: 36rpx 0;
  text-align: center;
  border-bottom: 1rpx solid var(--color-border);
}

.prayer-lamp {
  display: none;
}

.prayer-hero-copy {
  flex: 1;
  min-width: 0;
}

.prayer-title {
  display: block;
  color: var(--color-text);
  font-size: 40rpx;
  font-weight: 500;
}

.prayer-subtitle {
  color: var(--color-text-muted);
  display: block;
  font-size: 30rpx;
  line-height: 1.8;
  margin-top: 12rpx;
}

.mode-tabs {
  background: var(--color-surface-muted);
  border-radius: var(--radius-sm);
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  margin-bottom: 16rpx;
  padding: 4rpx;
}

.mode-tab {
  border-radius: 6rpx;
  color: var(--color-text-muted);
  font-size: 32rpx;
  height: var(--touch-min);
  line-height: var(--touch-min);
  min-height: var(--touch-min);
  text-align: center;
}

.mode-tab-active {
  background: linear-gradient(135deg, #f0a886, #b84a30);
  color: #2b0f08;
  font-weight: 600;
}

.prayer-form,
.record-panel {
  padding: 0;
}

.field-block {
  margin-bottom: 28rpx;
}

.prayer-input,
.prayer-area {
  background: var(--color-bg-warm);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  box-sizing: border-box;
  color: var(--color-text);
  font-size: 32rpx;
  padding: 0 16rpx;
  width: 100%;
}

.prayer-input {
  height: var(--touch-min);
  line-height: var(--touch-min);
  min-height: var(--touch-min);
}

.prayer-area {
  min-height: 160rpx;
  padding-top: 16rpx;
}

.prayer-tip,
.culture-note {
  color: var(--color-text-muted);
  display: block;
  font-size: 30rpx;
  line-height: 1.6;
}

.record-empty {
  color: var(--color-text-muted);
  font-size: 26rpx;
  padding: 24rpx 0;
}

.record-empty-icon {
  display: none;
}

.record-item {
  border-top: 1rpx solid var(--color-border-light);
  padding: 16rpx 0;
}

.record-top {
  align-items: baseline;
  display: flex;
  justify-content: space-between;
}

.record-name {
  font-size: 28rpx;
  font-weight: 600;
}

.record-status {
  color: var(--color-success);
  font-size: 22rpx;
}

.record-status-done {
  color: var(--color-text-muted);
}

.record-wish {
  display: block;
  font-size: 26rpx;
  line-height: 1.6;
  margin-top: 8rpx;
}

.record-meta,
.record-note {
  color: var(--color-text-muted);
  display: block;
  font-size: 22rpx;
  margin-top: 6rpx;
}

.record-actions {
  display: flex;
  gap: 12rpx;
  justify-content: flex-end;
  margin-top: 12rpx;
}

.record-btn {
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-sm) !important;
  color: var(--color-text);
  font-size: 24rpx;
  height: 72rpx;
  line-height: 70rpx;
  margin: 0;
  min-height: 72rpx;
  padding: 0 16rpx;
}

.record-btn-danger {
  color: var(--color-primary);
}

.record-btn::after {
  border: 0;
}

.culture-note {
  padding: 8rpx 0 calc(28rpx + env(safe-area-inset-bottom));
}
.prayer-page .field-label { font-size: 30rpx; margin-bottom: 12rpx; }
.prayer-page .field-help-error { font-size: 32rpx; }
.prayer-page .record-name { font-size: 34rpx; }
.prayer-page .record-wish { font-size: 32rpx; line-height: 1.8; overflow-wrap: anywhere; }
.prayer-page .record-meta, .prayer-page .record-note, .prayer-page .record-status { font-size: 28rpx; }
.prayer-page .record-top { gap: 16rpx; flex-wrap: wrap; }
.prayer-page .record-btn { height: 88rpx; line-height: 86rpx; font-size: 28rpx; }
