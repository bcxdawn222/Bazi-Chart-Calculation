.prayer-page {
  background: var(--color-bg);
  padding-top: 22rpx;
}

.prayer-hero {
  align-items: center;
  display: flex;
  margin-bottom: 22rpx;
  padding: 28rpx 26rpx;
}

.prayer-lamp {
  align-items: center;
  background: linear-gradient(180deg, #fde9dc, #f8d4bc);
  border: 1rpx solid #e6b99d;
  border-radius: 50%;
  box-shadow: var(--shadow-sm);
  color: #b84f38;
  display: flex;
  flex: 0 0 auto;
  font-size: 42rpx;
  height: 104rpx;
  justify-content: center;
  width: 104rpx;
}

.prayer-hero-copy {
  flex: 1;
  margin-left: 22rpx;
  min-width: 0;
}

.prayer-title {
  color: #5c3027;
  display: block;
  font-size: 36rpx;
  font-weight: 700;
}

.prayer-subtitle {
  color: #947b69;
  display: block;
  font-size: 20rpx;
  line-height: 1.65;
  margin-top: 8rpx;
}

.mode-tabs {
  background: #f3e5d4;
  border: 1rpx solid #e7d2ba;
  border-radius: var(--radius-md);
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  margin-bottom: 22rpx;
  padding: 6rpx;
}

.mode-tab {
  border-radius: 9rpx;
  color: #907663;
  font-size: 22rpx;
  height: 72rpx;
  line-height: 72rpx;
  min-height: 72rpx;
  text-align: center;
  transition: background var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out), box-shadow var(--duration-fast) var(--ease-out);
}

.mode-tab-active {
  background: var(--color-surface);
  box-shadow: 0 3rpx 12rpx rgba(102, 65, 42, .12);
  color: #a34830;
  font-weight: 700;
}

.prayer-form,
.record-panel {
  padding: 28rpx 26rpx;
}

.field-block {
  margin-bottom: 20rpx;
}

.prayer-input,
.prayer-area {
  background: var(--color-bg-warm);
  border: 1rpx solid #e6d2ba;
  border-radius: var(--radius-sm);
  box-sizing: border-box;
  color: #44332b;
  font-size: 23rpx;
  padding: 0 18rpx;
  width: 100%;
}

.prayer-input {
  height: var(--touch-min);
  line-height: var(--touch-min);
  min-height: var(--touch-min);
}

.prayer-area {
  min-height: 160rpx;
  padding-top: 18rpx;
}

.prayer-tip,
.culture-note {
  color: #927d6d;
  display: block;
  font-size: 19rpx;
  line-height: 1.7;
  text-align: center;
}

.record-empty {
  align-items: center;
  color: #927d6d;
  display: flex;
  flex-direction: column;
  font-size: 20rpx;
  gap: 16rpx;
  padding: 28rpx 0;
  text-align: center;
}

.record-empty-icon {
  align-items: center;
  background: var(--color-surface-muted);
  border: 1rpx dashed #e0c9b0;
  border-radius: 50%;
  color: #c07a5a;
  display: flex;
  font-size: 36rpx;
  height: 88rpx;
  justify-content: center;
  width: 88rpx;
}

.record-item {
  background: var(--color-surface-muted);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
  margin-bottom: 14rpx;
  padding: 20rpx;
}

.record-top {
  align-items: center;
  display: flex;
  justify-content: space-between;
}

.record-name {
  color: #984a32;
  font-size: 25rpx;
  font-weight: 700;
}

.record-status {
  background: var(--color-success-soft);
  border-radius: var(--radius-pill);
  color: var(--color-success);
  font-size: 17rpx;
  padding: 6rpx 14rpx;
}

.record-status-done {
  background: #f0f0f0;
  color: #8a8a8a;
}

.record-wish {
  color: #604a3e;
  display: block;
  font-size: 21rpx;
  line-height: 1.7;
  margin-top: 12rpx;
}

.record-meta,
.record-note {
  color: #967f6d;
  display: block;
  font-size: 18rpx;
  margin-top: 8rpx;
}

.record-actions {
  display: flex;
  gap: 12rpx;
  justify-content: flex-end;
  margin-top: 14rpx;
}

.record-btn {
  background: transparent;
  border: 1rpx solid #d5a273;
  border-radius: var(--radius-sm);
  color: #985035;
  font-size: 18rpx;
  height: 60rpx;
  line-height: 60rpx;
  margin: 0;
  min-height: 60rpx;
  padding: 0 18rpx;
}

.record-btn-danger {
  border-color: #e0b4a8;
  color: #b84d37;
}

.record-btn::after {
  border: 0;
}

.culture-note {
  padding: 10rpx 8rpx calc(30rpx + env(safe-area-inset-bottom));
}
