/* 保留既有双文件结构；所有展示色在此映射到全局变量。 */
.result-page { background: var(--color-bg); padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); animation: xj-focus .8s cubic-bezier(.2,.9,.2,1) both; }
.result-page .panel { background: transparent; border: 0; border-radius: 0; box-shadow: none; padding: 20rpx 0; margin-bottom: 32rpx; overflow: visible; }
.result-header { background: transparent; border: 0; border-radius: 0; box-shadow: none; margin-bottom: 24rpx; }
.result-header::before, .header-glow { display: none; }
.result-topline { background: transparent; border-bottom-color: var(--color-border-light); color: var(--color-text); padding: 0; }
.result-back, .back-chevron { color: var(--color-text-secondary); font-size: 30rpx; }
.share-button { color: var(--color-accent); font-size: 30rpx; }
.profile-row { padding: 36rpx 0; flex-direction: column; gap: 16rpx; position: relative; text-align: center; }
.profile-avatar { background: transparent; border: 0; border-radius: 50%; color: #f5cdb6; box-shadow: none; width: 160rpx; height: 160rpx; font-size: 64rpx; font-weight: 600; position: relative; animation: xj-float 6s ease-in-out infinite; }
.profile-avatar text { position: relative; z-index: 1; }
.day-master-ring { position: absolute; inset: 0; width: 100%; height: 100%; animation: xj-spin 30s linear infinite; }
.profile-copy { margin: 0; max-width: 100%; }
.profile-name { color: var(--color-text); font-size: 38rpx; font-weight: 500; }
.profile-meta { color: var(--color-text-muted); font-size: 28rpx; }
.profile-status { background: transparent; border: 1rpx solid var(--color-border); border-radius: 8rpx; color: var(--color-success); font-size: 24rpx; margin: 0; padding: 6rpx 14rpx; }
.birth-summary { border-top-color: var(--color-border-light); padding: 6rpx 0 24rpx; }
.birth-summary > view { grid-template-columns: 72rpx minmax(0, 1fr); gap: 16rpx; padding-top: 16rpx; }
.summary-label { color: var(--color-text-muted); font-size: 30rpx; }
.summary-value { color: var(--color-text-secondary); font-size: 30rpx; overflow-wrap: anywhere; }
.correction-line { background: var(--color-surface); border-radius: 8rpx; color: var(--color-text-muted); font-size: 26rpx; padding: 20rpx; }
.result-tabs { background: var(--color-bg); border: 0; border-bottom: 1rpx solid var(--color-border); border-radius: 0; padding: 8rpx 0; }
.result-tab { border-radius: 8rpx; color: var(--color-text-muted); font-size: 32rpx; }
.result-tab-active { background: var(--color-accent-soft); box-shadow: none; color: var(--color-accent); font-weight: 500; }
.result-tab-active::after { display: none; }
.overview-item { border-right-color: var(--color-border); }
.overview-label, .overview-note { color: var(--color-text-muted); font-size: 28rpx; }
.overview-value { color: var(--color-accent); font-size: 44rpx; font-weight: 500; text-shadow: none; }
.overview-item .overview-text { font-size: 32rpx; }
.bazi-table { grid-template-columns: 76rpx repeat(4, minmax(0, 1fr)); gap: 6rpx; }
.table-cell { padding: 8rpx 2rpx; min-width: 0; overflow-wrap: anywhere; line-height: 1.6; }
.table-label { background: transparent; border: 0; color: var(--color-text-muted); font-size: 28rpx; font-weight: 400; }
.table-head { background: var(--color-surface); border: 1rpx solid var(--color-border); border-radius: 8rpx; color: var(--color-text-muted); font-size: 28rpx; }
.pillar-main { background: var(--color-surface); border: 1rpx solid var(--color-border); border-radius: 8rpx; color: #f5cdb6; font-size: 48rpx; font-weight: 600; min-height: 176rpx; flex-direction: column; gap: 12rpx; animation: xj-pillar .7s cubic-bezier(.2,.9,.2,1) both; }
.pillar-stem { font-size: 48rpx; line-height: 1; }
.pillar-branch { font-size: 38rpx; line-height: 1; color: var(--color-text); }
.pillar-main:nth-child(8) { animation-delay: .1s; }
.pillar-main:nth-child(9) { animation-delay: .22s; }
.pillar-main:nth-child(10) { animation-delay: .34s; }
.table-value { color: var(--color-text); font-size: 30rpx; }
.table-small { color: var(--color-text-muted); font-size: 28rpx; }
.cycle-note { background: transparent; border-left-color: var(--color-primary); color: var(--color-text-secondary); font-size: 30rpx; }
.horizontal-list { margin: 0; }
.luck-item, .year-item, .transform-item { background: var(--color-surface); border-color: var(--color-border); border-radius: 12rpx; }
.luck-pillar, .transform-name { color: var(--color-accent); font-weight: 500; }
.luck-age, .year-palace, .transform-palace { color: var(--color-text-muted); font-size: 32rpx; }
.luck-item { min-width: 156rpx; padding: 20rpx 12rpx; }
.year-item { min-width: 180rpx; padding: 20rpx 12rpx; }
.subheading { color: var(--color-text); letter-spacing: 0; font-size: 32rpx; }
.year-number { color: var(--color-accent); }
.year-pillar, .transform-star { color: var(--color-text-secondary); font-size: 32rpx; }
.element-name { font-size: 32rpx; width: 48rpx; }
.bar-track { background: var(--color-surface-raised); border: 0; height: 12rpx; }
.bar-fill { box-shadow: none; transform-origin: left; animation: xj-bar 1.1s cubic-bezier(.2,.9,.2,1) both; }
.element-percent { color: var(--color-text-secondary); font-size: 28rpx; width: 80rpx; }
.element-count { color: var(--color-text-muted); font-size: 28rpx; }
.shensha-item { background: transparent; border: 0; border-bottom: 1rpx solid var(--color-border-light); border-radius: 0; padding: 20rpx 0; }
.shensha-name { color: var(--color-text); font-size: 32rpx; }
.shensha-position { color: var(--color-text-muted); font-size: 30rpx; }
.ziwei-summary { background: var(--color-surface); color: var(--color-text-secondary); font-size: 30rpx; }
.palace-grid { gap: 8rpx; }
.palace { background: var(--color-surface); border-color: var(--color-border); border-radius: 8rpx; padding: 16rpx 6rpx; overflow-wrap: anywhere; }
.palace-selected { background: var(--color-primary-soft); border-color: var(--color-primary); box-shadow: none; }
.palace-heading { flex-wrap: wrap; }
.palace-name { color: var(--color-accent); font-size: 32rpx; font-weight: 500; }
.palace-branch, .palace-aux { color: var(--color-text-muted); font-size: 32rpx; line-height: 1.6; }
.palace-stars { color: var(--color-text); font-size: 32rpx; }
.palace-brightness { color: var(--color-primary); font-size: 32rpx; }
.selected-heading { border-bottom-color: var(--color-border); flex-wrap: wrap; gap: 12rpx; }
.selected-name { color: var(--color-accent); letter-spacing: 0; }
.selected-branch { color: var(--color-text-muted); font-size: 30rpx; }
.selected-daxian { background: var(--color-primary-soft); color: var(--color-primary); font-size: 28rpx; border-radius: 8rpx; }
.selected-label { color: var(--color-text-muted); font-size: 30rpx; letter-spacing: 0; }
.selected-block text:not(.selected-label), .transformation-list text { color: var(--color-text-secondary); font-size: 32rpx; }
.selected-main { color: var(--color-text) !important; font-size: 36rpx !important; }
.analysis-nav { gap: 8rpx; }
.analysis-nav-item { color: var(--color-text-muted); font-size: 28rpx; text-align: center; min-width: 0; }
.analysis-icon { background: transparent; border-color: var(--color-border); border-radius: 8rpx; color: var(--color-accent); font-size: 30rpx; }
.analysis-item { border-top-color: var(--color-border-light); padding: 28rpx 0; }
.analysis-label { color: var(--color-accent); font-size: 34rpx; }
.analysis-text { color: var(--color-text-secondary); font-size: 32rpx; line-height: 1.9; }
.notice-block { background: var(--color-surface); border-left-color: var(--color-accent); color: var(--color-text-muted); font-size: 28rpx; }
.empty { color: var(--color-text-muted); font-size: 32rpx; }
