.tool-page { background: var(--color-bg); padding-top: 8rpx; animation: xj-rise .55s cubic-bezier(.22,.9,.24,1) both; }
.tool-page .panel { background: transparent; border: 0; box-shadow: none; padding: 0; overflow: visible; }
.tool-page .panel::before { display: none; }

.tool-hero {
  align-items: center;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 12rpx 0 36rpx;
  text-align: center;
  border: 0;
}
.tool-kicker { display: flex; align-items: center; justify-content: center; gap: 20rpx; width: 100%; }
.kicker-line { width: 48rpx; height: 1rpx; background: rgba(240,168,134,.45); }
.tool-mark, .consult-seal { display: none; }
.tool-hero-copy { min-width: 0; }
.tool-title, .consult-title, .result-title {
  color: var(--color-accent);
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 10rpx;
}
.tool-subtitle, .consult-copy {
  color: rgba(179,156,146,.75);
  display: block;
  font-size: 22rpx;
  line-height: 1.9;
  margin-top: 16rpx;
}

.tool-form, .consult-panel, .result-card {
  border: 1rpx solid rgba(245,237,230,.08);
  border-radius: 30rpx;
  background: rgba(30,16,13,.55);
  padding: 24rpx 0 32rpx;
  margin-bottom: 28rpx;
}
.tool-form .section-head, .consult-panel .section-head { padding: 4rpx 28rpx 20rpx; }
.tool-page .section-title { color: var(--color-text); font-size: 28rpx; letter-spacing: 6rpx; font-weight: 500; }
.tool-page .section-caption { letter-spacing: 2rpx; font-size: 20rpx; }

.chart-state { color: var(--color-success); font-size: 22rpx; margin: 0 28rpx 16rpx; letter-spacing: 2rpx; }
.status-dot { display: none; }
.empty-state {
  margin: 0 28rpx 20rpx;
  padding: 24rpx;
  border: 1rpx dashed rgba(240,168,134,.3);
  border-radius: 20rpx;
  background: rgba(232,130,95,.05);
  color: rgba(245,237,230,.62);
  font-size: 26rpx;
  line-height: 1.7;
}
.minor-button {
  background: rgba(232,130,95,.08) !important;
  border: 1rpx solid rgba(240,168,134,.4);
  border-radius: 999rpx !important;
  color: #f5cdb6 !important;
  font-size: 26rpx;
  letter-spacing: 4rpx;
  height: 72rpx;
  line-height: 70rpx;
  margin: 20rpx 0 0;
  min-height: 72rpx;
  padding: 0 28rpx;
  width: auto;
}
.minor-button::after { border: 0; }

.field-block {
  display: grid;
  grid-template-columns: 160rpx minmax(0, 1fr);
  align-items: center;
  margin: 0;
  min-width: 0;
  min-height: 112rpx;
  padding: 12rpx 28rpx;
  border-bottom: 1rpx solid rgba(245,237,230,.05);
  box-sizing: border-box;
}
.field-stack { display: block; padding-top: 20rpx; padding-bottom: 20rpx; }
.field-label { color: rgba(179,156,146,.9); display: block; font-size: 24rpx; letter-spacing: 4rpx; margin: 0; }
.field-stack .field-label { margin-bottom: 16rpx; }
.text-input, .text-area, .picker-value {
  background: transparent;
  border: 0;
  border-radius: 0;
  box-sizing: border-box;
  color: #f5cdb6;
  font-size: 32rpx;
  width: 100%;
  font-family: "Noto Serif SC", "Source Han Serif SC", "Songti SC", "STSong", "SimSun", serif;
}
.text-input, .picker-value { height: var(--touch-min); line-height: var(--touch-min); min-height: var(--touch-min); padding: 0 4rpx; text-align: right; }
.text-area { min-height: 150rpx; padding: 8rpx 0; text-align: left; color: var(--color-text); }
.picker-value { align-items: center; display: flex; justify-content: flex-end; gap: 12rpx; }
.input-placeholder { color: var(--color-text-hint); }
.field-grid, .compact-grid { display: block; gap: 0; }
.party-block { border-top: 1rpx solid rgba(245,237,230,.07); margin: 0; padding: 8rpx 0 0; }
.party-title { display: block; font-size: 24rpx; font-weight: 500; letter-spacing: 8rpx; color: var(--color-accent); padding: 20rpx 28rpx 8rpx; }
.option-row {
  align-items: center;
  display: flex;
  font-size: 24rpx;
  letter-spacing: 4rpx;
  justify-content: space-between;
  margin: 0;
  min-height: 112rpx;
  padding: 12rpx 28rpx;
  border-bottom: 1rpx solid rgba(245,237,230,.05);
  color: rgba(179,156,146,.9);
}
.form-tip, .formula-note, .evidence-note, .culture-note { color: rgba(179,156,146,.7); font-size: 22rpx; line-height: 1.7; }
.form-tip {
  background: transparent;
  border-radius: 0;
  margin: 0;
  padding: 20rpx 28rpx;
  border-bottom: 1rpx solid rgba(245,237,230,.05);
}
.form-tip-ready { color: #f5cdb6; }

.consult-panel { display: flex; flex-direction: column; padding-bottom: 32rpx; }
.consult-seal { margin-bottom: 8rpx; }
.consult-title { padding: 8rpx 28rpx 0; text-align: center; }
.consult-panel .gold-btn, .tool-form .gold-btn { margin: 28rpx 28rpx 8rpx; width: auto; }
.consult-loading, .consult-empty { color: rgba(179,156,146,.7); font-size: 26rpx; line-height: 1.7; padding: 20rpx 28rpx; }
.consult-content { width: 100%; }
.consult-state { color: var(--color-success); font-size: 22rpx; margin: 12rpx 28rpx; }
.consult-copy { padding: 0 28rpx; }
.expert-item { border-top: 1rpx solid rgba(245,237,230,.05); padding: 20rpx 28rpx; }
.expert-item-selected { background: rgba(232,130,95,.13); }
.consult-subject-field { margin-top: 0; width: 100%; }
.expert-top { color: var(--color-text-muted); display: flex; justify-content: space-between; }
.expert-name { color: var(--color-text); font-size: 30rpx; font-weight: 500; }
.expert-bio, .expert-price { color: var(--color-text-secondary); display: block; font-size: 24rpx; margin-top: 6rpx; }
.schedule-list, .order-list { margin-top: 8rpx; }
.schedule-item, .order-item { border-top: 1rpx solid rgba(245,237,230,.05); color: var(--color-text-secondary); display: flex; font-size: 24rpx; justify-content: space-between; padding: 20rpx 28rpx; }
.schedule-item-selected { color: var(--color-accent); background: rgba(232,130,95,.08); }
.order-list-head { align-items: center; display: flex; justify-content: space-between; padding: 0 28rpx; }
.icon-refresh { background: transparent; border: 0; color: var(--color-accent); font-size: 24rpx; line-height: 52rpx; margin: 0; min-height: 52rpx; padding: 0; }
.record-btn {
  background: rgba(245,237,230,.04) !important;
  border: 1rpx solid rgba(240,168,134,.28);
  border-radius: 16rpx !important;
  color: #f5cdb6 !important;
  font-size: 26rpx;
  letter-spacing: 2rpx;
  line-height: 86rpx;
  margin: 16rpx 28rpx 0;
  min-height: 88rpx;
  padding: 0 16rpx;
}
.record-btn::after { border: 0; }
.order-item { flex-direction: column; gap: 8rpx; }
.order-item view { display: flex; justify-content: space-between; }
.order-status { color: var(--color-accent); }

.result-stack { display: block; }
.result-card { padding: 32rpx 28rpx; }
.result-card .result-title { font-size: 36rpx; letter-spacing: 8rpx; color: var(--color-text); margin-bottom: 16rpx; }
.result-tags { display: flex; flex-wrap: wrap; gap: 12rpx; margin: 12rpx 0 20rpx; }
.result-tags text {
  background: rgba(232,130,95,.1);
  border: 1rpx solid rgba(240,168,134,.28);
  border-radius: 8rpx;
  color: #f5cdb6;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  padding: 8rpx 14rpx;
}
.result-summary, .wealth-note { color: var(--color-text-secondary); display: block; font-size: 28rpx; line-height: 1.9; margin-bottom: 16rpx; }
.detail-row { border-top: 1rpx solid rgba(245,237,230,.05); display: grid; gap: 14rpx; grid-template-columns: 100rpx minmax(0, 1fr); padding: 18rpx 0; }
.detail-label { color: var(--color-accent); font-size: 24rpx; letter-spacing: 2rpx; }
.detail-text { color: var(--color-text-secondary); font-size: 26rpx; line-height: 1.7; }
.detail-subtext { color: var(--color-text-muted); display: block; font-size: 24rpx; margin-top: 4rpx; }
.time-basis, .chart-reference {
  background: rgba(232,130,95,.05);
  border: 1rpx dashed rgba(240,168,134,.28);
  border-radius: 16rpx;
  color: var(--color-text-secondary);
  display: flex;
  flex-direction: column;
  font-size: 24rpx;
  gap: 8rpx;
  margin: 16rpx 0;
  padding: 18rpx 20rpx;
}
.month-grid { display: grid; gap: 10rpx; grid-template-columns: repeat(3, minmax(0, 1fr)); margin: 16rpx 0; }
.month-item, .element-pair, .grid-item {
  background: rgba(245,237,230,.03);
  border: 1rpx solid rgba(240,168,134,.14);
  border-radius: 16rpx;
  color: var(--color-text-secondary);
  display: flex;
  flex-direction: column;
  font-size: 22rpx;
  gap: 6rpx;
  padding: 16rpx 10rpx;
  text-align: center;
}
.month-item text:first-child, .grid-item text:first-child { color: var(--color-text); }
.hexagram { background: rgba(245,237,230,.03); border-radius: 16rpx; margin: 16rpx 0; padding: 20rpx; }
.hex-line { align-items: center; display: flex; font-size: 26rpx; justify-content: space-between; margin: 10rpx auto; max-width: 420rpx; color: #f5cdb6; }
.moving-line { color: var(--color-primary); }
.couple-grid { display: grid; gap: 12rpx; grid-template-columns: repeat(2, minmax(0, 1fr)); margin: 16rpx 0; }
.person-card { background: rgba(245,237,230,.03); border: 1rpx solid rgba(240,168,134,.14); border-radius: 16rpx; font-size: 26rpx; line-height: 1.7; padding: 18rpx 14rpx; }
.pillar-mini { border-bottom: 1rpx solid var(--color-border); border-top: 1rpx solid var(--color-border); color: var(--color-text-muted); display: flex; flex-direction: column; font-size: 22rpx; margin: 10rpx 0; padding: 8rpx 0; }
.element-pair { display: grid; grid-template-columns: 40rpx repeat(3, 1fr); }
.character-row { display: flex; gap: 28rpx; margin: 16rpx 0; justify-content: center; }
.character-row view { align-items: center; color: var(--color-text-muted); display: flex; flex-direction: column; font-size: 22rpx; }
.character { color: #f5cdb6; font-size: 56rpx; }
.grid-list { display: grid; gap: 10rpx; grid-template-columns: repeat(5, minmax(0, 1fr)); }
.grid-number { color: #f5cdb6; font-size: 32rpx; }
.culture-note { padding: 8rpx 0 calc(28rpx + env(safe-area-inset-bottom)); text-align: center; letter-spacing: 2rpx; }
.tool-page .field-help, .tool-page .field-help-error { font-size: 24rpx; line-height: 1.6; margin-top: 8rpx; display: block; grid-column: 1 / -1; }
.tool-page .field-help-error { color: var(--color-primary); }
.tool-page .schedule-item, .tool-page .expert-top { gap: 16rpx; flex-wrap: wrap; }
.tool-page .order-item view { gap: 16rpx; flex-wrap: wrap; }
